                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {"value": "stockout", "color": "#E5484D"},
                      {"value": "at_risk", "color": "#FFB020"},
                      {"value": "overstock", "color": "#FFB020"},
                      {"value": "healthy", "color": "#3C6997"}
