{
  "datasets": [
    {
      "name": "ds_exposure",
      "displayName": "Exposure by zone/category/status",
      "queryLines": [
        "SELECT climate_zone, region, category, position_status, ",
        "  MEASURE(`lost_sales_exposure`) AS lost_sales_usd, ",
        "  MEASURE(`markdown_exposure`) AS markdown_usd, ",
        "  MEASURE(`stockout_count`) AS stockout_count, ",
        "  MEASURE(`overstock_count`) AS overstock_count, ",
        "  MEASURE(`position_count`) AS position_count ",
        "FROM mv_store_position ",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "ds_positions",
      "displayName": "Store SKU positions",
      "queryLines": [
        "SELECT store_id, store_name, region, climate_zone, city, store_lat, store_lng, ",
        "  product_id, product_name, category, seasonality, position_status, ",
        "  on_hand_units, recent_units_7d, weeks_of_supply, ",
        "  lost_sales_exposure_usd, markdown_exposure_usd, markdown_risk_score ",
        "FROM gold_store_sku_position ",
        "ORDER BY lost_sales_exposure_usd DESC"
      ]
    },
    {
      "name": "ds_recovery",
      "displayName": "Recovery recommendations (with names)",
      "queryLines": [
        "SELECT r.store_id, r.product_id, r.recommended_move, r.recommended_source_store_id, ",
        "  r.predicted_recaptured_usd, r.predicted_net_value_usd, ",
        "  s.store_name, s.product_name ",
        "FROM gold_recovery_recommendations r ",
        "JOIN (SELECT DISTINCT store_id, product_id, store_name, product_name FROM gold_store_sku_position) s ",
        "  ON r.store_id = s.store_id AND r.product_id = s.product_id ",
        "ORDER BY r.predicted_net_value_usd DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "operations",
      "displayName": "Operations",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "page1-title",
            "multilineTextboxSpec": {
              "lines": [
                "## NorthPeak Store Operations\n\nDana Ruiz, SVP Retail Ops. An early cold snap ~3 weeks ago left the same cold-weather styles **SOLD OUT in the North** (red — lost sales) and **DEAD STOCK in the South** (amber — markdown clock). This page tracks the headline exposure and where it lives. Use the Filters panel to narrow by climate zone, region, category, or position status."
              ]
            }
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-lost-sales",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_exposure",
                  "fields": [
                    {"name": "sum(lost_sales_usd)", "expression": "SUM(`lost_sales_usd`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(lost_sales_usd)",
                  "displayName": "Lost-Sales Exposure",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {"type": "max", "places": 2}
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Lost-Sales Exposure",
                "showDescription": true,
                "description": "Money leaking from stocked-out northern stores (red positions)"
              }
            }
          },
          "position": {"x": 0, "y": 3, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-markdown",
            "queries": [
              {
