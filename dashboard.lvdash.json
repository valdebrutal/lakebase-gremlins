                    {"name": "store_lat", "expression": "`store_lat`"},
                    {"name": "store_lng", "expression": "`store_lng`"},
                    {"name": "position_status", "expression": "`position_status`"},
                    {"name": "recent_units_7d", "expression": "`recent_units_7d`"},
                    {"name": "store_name", "expression": "`store_name`"},
                    {"name": "city", "expression": "`city`"},
                    {"name": "on_hand_units", "expression": "`on_hand_units`"},
                    {"name": "product_name", "expression": "`product_name`"}
                  ],
                  "disaggregated": true,
                  "filters": [
                    {"expression": "`product_id` IN ('SKU-APP-04412','SKU-APP-04418','SKU-APP-04431','SKU-APP-04455','SKU-APP-04460')"}
